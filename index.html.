<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Animated Tic Tac Toe</title>
    <!-- Three.js for 3D Animations & Google Fonts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-height: 100vh; background-color: #050515; color: #ffffff; overflow: hidden; position: relative;
        }
        #bg-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
        .ui-container { position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; }
        h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.8rem; margin-bottom: 15px; text-shadow: 0 0 20px rgba(0, 242, 254, 0.9);
            letter-spacing: 3px; animation: pulse 2s infinite alternate;
        }
        @keyframes pulse {
            0% { transform: scale(1); text-shadow: 0 0 20px rgba(0, 242, 254, 0.8); }
            100% { transform: scale(1.03); text-shadow: 0 0 30px rgba(255, 65, 108, 0.9); }
        }
        .modal {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7); display: flex; align-items: center; justify-content: center;
            z-index: 999; backdrop-filter: blur(10px);
        }
        .modal-content {
            background: rgba(15, 23, 42, 0.9); padding: 25px 30px 30px 30px; border-radius: 24px;
            border: 1px solid rgba(0, 242, 254, 0.4); box-shadow: 0 0 40px rgba(0, 242, 254, 0.3);
            text-align: center; width: 460px; animation: floatIn 0.5s ease-out;
        }
        @keyframes floatIn { from { transform: translateY(-30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        
        .brand-3d-wrapper {
            width: 100%; height: 110px; position: relative; margin-bottom: 0px;
        }
        #brand-canvas { width: 100%; height: 100%; display: block; }

        .modal-content h2 { margin-bottom: 15px; color: #00f2fe; font-size: 1.4rem; font-family: 'Orbitron', sans-serif; }
        .option-group { margin-bottom: 15px; text-align: left; }
        .option-group label { display: block; margin-bottom: 6px; font-size: 0.9rem; color: #cbd5e1; }
        .btn-group { display: flex; gap: 6px; flex-wrap: wrap; }
        .opt-btn {
            flex: 1; padding: 8px 10px; font-size: 0.85rem; font-weight: 600;
            background: rgba(255, 255, 255, 0.08); color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 10px;
            cursor: pointer; transition: all 0.3s ease; white-space: nowrap;
        }
        .opt-btn.active {
            background: #00f2fe !important; color: #050515 !important;
            border-color: #00f2fe !important; box-shadow: 0 0 15px rgba(0, 242, 254, 0.6);
            transform: scale(1.02);
        }
        .start-btn {
            width: 100%; padding: 14px; font-size: 1.1rem; font-weight: bold; color: #fff;
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(45deg, #00f2fe, #ff416c); border: none;
            border-radius: 14px; cursor: pointer; margin-top: 10px;
            box-shadow: 0 5px 20px rgba(0, 242, 254, 0.4); transition: transform 0.2s;
        }
        .start-btn:hover { transform: scale(1.04); }
        #status { font-size: 1.4rem; margin-bottom: 15px; font-weight: 600; color: #00f2fe; text-shadow: 0 0 10px rgba(0, 242, 254, 0.8); }
        .board {
            display: grid; grid-gap: 10px; background: rgba(0, 0, 0, 0.6);
            padding: 15px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8); backdrop-filter: blur(12px);
        }
        .cell {
            background: rgba(255, 255, 255, 0.08); border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; cursor: pointer; border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s ease; user-select: none;
            font-family: 'Orbitron', sans-serif;
        }
        .cell:hover { background: rgba(0, 242, 254, 0.2); transform: scale(1.05); box-shadow: 0 0 15px rgba(0, 242, 254, 0.5); }
        
        .controls-wrapper { display: flex; gap: 10px; margin-top: 20px; }
        
        .action-btn {
            padding: 12px 20px; font-size: 0.95rem; font-weight: bold; color: #fff;
            font-family: 'Orbitron', sans-serif; border: none;
            border-radius: 16px; cursor: pointer; transition: transform 0.2s;
        }
        #restartBtn {
            display: none;
            background: linear-gradient(45deg, #00f2fe, #4facfe);
            box-shadow: 0 5px 20px rgba(0, 242, 254, 0.4);
        }
        #changeSettingsBtn {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            box-shadow: 0 5px 20px rgba(255, 65, 108, 0.4);
        }
        .action-btn:hover { transform: scale(1.05); }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>

    <div class="ui-container">
        <h1>Tic Tac Toe 3D</h1>

        <div id="setupModal" class="modal">
            <div class="modal-content">
                <div class="brand-3d-wrapper">
                    <canvas id="brand-canvas"></canvas>
                </div>
                <h2>Game Setup</h2>
                
                <div class="option-group">
                    <label>Choose Opponent:</label>
                    <div class="btn-group">
                        <button id="vsFriendBtn" class="opt-btn active" onclick="selectMode('friend')">Friend 👥</button>
                        <button id="vsRobotBtn" class="opt-btn" onclick="selectMode('robot')">Bot 🤖</button>
                    </div>
                </div>

                <div class="option-group" id="difficultyGroup" style="display: none;">
                    <label>Choose Bot Difficulty:</label>
                    <div class="btn-group">
                        <button id="diffEasyBtn" class="opt-btn" onclick="selectDifficulty('easy')">Easy 🟢</button>
                        <button id="diffMediumBtn" class="opt-btn active" onclick="selectDifficulty('medium')">Medium 🟡</button>
                        <button id="diffHardBtn" class="opt-btn" onclick="selectDifficulty('hard')">Hard 🟠</button>
                        <button id="diffImpossibleBtn" class="opt-btn" onclick="selectDifficulty('impossible')">Impossible 🔴</button>
                    </div>
                </div>

                <div class="option-group">
                    <label>Choose Grid Size:</label>
                    <div class="btn-group">
                        <button id="grid3Btn" class="opt-btn active" onclick="selectGrid(3, 3)">3 x 3</button>
                        <button id="grid5Btn" class="opt-btn" onclick="selectGrid(5, 5)">5 x 5</button>
                        <button id="grid6Btn" class="opt-btn" onclick="selectGrid(6, 6)">6 x 6</button>
                    </div>
                </div>

                <button class="start-btn" onclick="startGame()">PLAY NOW 🚀</button>
            </div>
        </div>

        <div id="status">Configure settings to play!</div>
        <div class="board" id="board"></div>
        
        <div class="controls-wrapper">
            <button id="restartBtn" class="action-btn" onclick="initGame()">Play Again 🔄</button>
            <button id="changeSettingsBtn" class="action-btn" onclick="openSettings()">Change Options ⚙️</button>
        </div>
    </div>

    <script>
        /* PURE WEB AUDIO SYNTHESIZER */
        let audioCtx;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        window.addEventListener('click', initAudio, { once: false });

        function playSound(type) {
            initAudio();
            if (!audioCtx) return;

            const now = audioCtx.currentTime;

            if (type === 'move') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.08);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc.start(now);
                osc.stop(now + 0.08);
            } 
            else if (type === 'win') {
                // Generates a 6-Second Victory Fanfare Sequence dynamically
                const notes = [261.63, 329.63, 392.00, 523.25, 659.25, 783.99, 1046.50];
                const noteDuration = 0.25;
                const totalLoops = Math.floor(6.0 / (notes.length * noteDuration));

                for (let loop = 0; loop < totalLoops; loop++) {
                    notes.forEach((freq, index) => {
                        const noteTime = now + (loop * notes.length + index) * noteDuration;
                        if (noteTime - now < 6.0) {
                            const osc = audioCtx.createOscillator();
                            const gain = audioCtx.createGain();
                            osc.type = 'triangle';
                            osc.frequency.setValueAtTime(freq, noteTime);
                            
                            gain.gain.setValueAtTime(0.25, noteTime);
                            gain.gain.exponentialRampToValueAtTime(0.001, noteTime + noteDuration - 0.02);
                            
                            osc.connect(gain);
                            gain.connect(audioCtx.destination);
                            
                            osc.start(noteTime);
                            osc.stop(noteTime + noteDuration);
                        }
                    });
                }
            } 
            else if (type === 'lose') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(80, now + 0.5);
                gain.gain.setValueAtTime(0.4, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.start(now);
                osc.stop(now + 0.5);
            }
        }

        /* 1. BACKGROUND 3D ENGINE */
        const canvas = document.getElementById('bg-canvas');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });

        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);

        const cubesGroup = new THREE.Group();
        const geometry = new THREE.BoxGeometry(1.2, 1.2, 1.2);
        
        for (let i = 0; i < 40; i++) {
            const material = new THREE.MeshBasicMaterial({
                color: i % 2 === 0 ? 0x00f2fe : 0xff416c,
                wireframe: true
            });
            const cube = new THREE.Mesh(geometry, material);
            cube.position.x = (Math.random() - 0.5) * 30;
            cube.position.y = (Math.random() - 0.5) * 30;
            cube.position.z = (Math.random() - 0.5) * 30;
            cube.rotation.x = Math.random() * Math.PI;
            cube.rotation.y = Math.random() * Math.PI;
            cubesGroup.add(cube);
        }
        scene.add(cubesGroup);
        camera.position.z = 15;

        function animate3D() {
            requestAnimationFrame(animate3D);
            cubesGroup.rotation.x += 0.002;
            cubesGroup.rotation.y += 0.003;
            cubesGroup.children.forEach((c) => {
                c.rotation.x += 0.01;
                c.rotation.y += 0.01;
            });
            renderer.render(scene, camera);
        }
        animate3D();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        /* 2. ALYAN PLAYS 3D FLOATING TEXT ENGINE */
        const brandCanvas = document.getElementById('brand-canvas');
        const bScene = new THREE.Scene();
        const bCamera = new THREE.PerspectiveCamera(50, 380 / 110, 0.1, 100);
        const bRenderer = new THREE.WebGLRenderer({ canvas: brandCanvas, alpha: true, antialias: true });

        bRenderer.setSize(380, 110);
        bCamera.position.z = 3.6;

        const textCanvas = document.createElement('canvas');
        textCanvas.width = 1024;
        textCanvas.height = 256;
        const ctx = textCanvas.getContext('2d');
        ctx.font = '900 110px "Orbitron", sans-serif';
        ctx.fillStyle = '#ff416c';
        ctx.shadowColor = '#ff416c';
        ctx.shadowBlur = 35;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('ALYAN PLAYS', 512, 128);

        const texture = new THREE.CanvasTexture(textCanvas);
        const planeGeo = new THREE.PlaneGeometry(8.5, 2.1);
        const planeMat = new THREE.MeshBasicMaterial({ map: texture, transparent: true });
        const brandMesh = new THREE.Mesh(planeGeo, planeMat);
        bScene.add(brandMesh);

        let floatAngle = 0;
        function animateBrand() {
            requestAnimationFrame(animateBrand);
            floatAngle += 0.04;
            brandMesh.position.y = Math.sin(floatAngle) * 0.12;
            brandMesh.rotation.y = Math.sin(floatAngle * 0.5) * 0.12;
            brandMesh.rotation.x = Math.cos(floatAngle * 0.5) * 0.05;
            bRenderer.render(bScene, bCamera);
        }
        animateBrand();

        /* 3. GAME LOGIC ENGINE */
        let selectedMode = "friend";
        let selectedDifficulty = "medium";
        let selectedGridSize = 3;
        let selectedWinCondition = 3;

        let options = [];
        let currentPlayer = "X";
        let running = false;

        function selectMode(mode) {
            selectedMode = mode;
            document.getElementById('vsFriendBtn').classList.toggle('active', mode === 'friend');
            document.getElementById('vsRobotBtn').classList.toggle('active', mode === 'robot');
            document.getElementById('difficultyGroup').style.display = mode === 'robot' ? 'block' : 'none';
        }

        function selectDifficulty(diff) {
            selectedDifficulty = diff;
            document.getElementById('diffEasyBtn').classList.toggle('active', diff === 'easy');
            document.getElementById('diffMediumBtn').classList.toggle('active', diff === 'medium');
            document.getElementById('diffHardBtn').classList.toggle('active', diff === 'hard');
            document.getElementById('diffImpossibleBtn').classList.toggle('active', diff === 'impossible');
        }

        function selectGrid(size, winReq) {
            selectedGridSize = size;
            selectedWinCondition = winReq;
            
            document.getElementById('grid3Btn').classList.toggle('active', size === 3);
            document.getElementById('grid5Btn').classList.toggle('active', size === 5);
            document.getElementById('grid6Btn').classList.toggle('active', size === 6);
        }

        function startGame() {
            initAudio();
            document.getElementById('setupModal').style.display = "none";
            initGame();
        }

        function openSettings() {
            running = false;
            document.getElementById('setupModal').style.display = "flex";
        }

        function initGame() {
            options = Array(selectedGridSize * selectedGridSize).fill("");
            currentPlayer = "X";
            running = true;

            document.getElementById('restartBtn').style.display = "none";
            const statusText = document.getElementById('status');
            statusText.textContent = selectedMode === "robot" ? "Your Turn (X)" : "Turn: Player X";

            const boardElement = document.getElementById('board');
            const cellSize = selectedGridSize === 3 ? '95px' : selectedGridSize === 5 ? '60px' : '50px';
            
            boardElement.style.gridTemplateColumns = `repeat(${selectedGridSize}, ${cellSize})`;
            boardElement.style.gridTemplateRows = `repeat(${selectedGridSize}, ${cellSize})`;
            boardElement.innerHTML = "";

            for (let i = 0; i < selectedGridSize * selectedGridSize; i++) {
                const cell = document.createElement('div');
                cell.classList.add('cell');
                cell.style.fontSize = selectedGridSize === 3 ? '2.5rem' : '1.5rem';
                cell.setAttribute('data-index', i);
                cell.onclick = function() { cellClicked(i); };
                boardElement.appendChild(cell);
            }
        }

        function cellClicked(index) {
            if (options[index] !== "" || !running) return;
            if (selectedMode === "robot" && currentPlayer === "O") return;

            makeMove(index, currentPlayer);

            if (running && selectedMode === "robot" && currentPlayer === "O") {
                setTimeout(robotMove, 300);
            }
        }

        function makeMove(index, player) {
            options[index] = player;
            playSound('move');
            
            const boardElement = document.getElementById('board');
            const cell = boardElement.children[index];
            cell.textContent = player;
            cell.style.color = player === "X" ? "#00f2fe" : "#ff416c";
            cell.style.textShadow = player === "X" ? "0 0 15px #00f2fe" : "0 0 15px #ff416c";

            if (checkBoardWin(options, player)) {
                if (selectedMode === "robot") {
                    if (player === "X") {
                        document.getElementById('status').textContent = "You Win! 🎉";
                        playSound('win');
                    } else {
                        document.getElementById('status').textContent = "Bot Wins! 🤖";
                        playSound('lose');
                    }
                } else {
                    document.getElementById('status').textContent = `Player ${player} Wins! 🎉`;
                    playSound('win');
                }
                endGame();
            } else if (!options.includes("")) {
                document.getElementById('status').textContent = "Draw! 🤝";
                playSound('lose');
                endGame();
            } else {
                currentPlayer = currentPlayer === "X" ? "O" : "X";
                document.getElementById('status').textContent = selectedMode === "robot" 
                    ? (currentPlayer === "X" ? "Your Turn (X)" : "Bot thinking... 🤖") 
                    : `Turn: Player ${currentPlayer}`;
            }
        }

        function endGame() {
            running = false;
            document.getElementById('restartBtn').style.display = "inline-block";
        }

        /* BOT AI LOGIC */
        function robotMove() {
            if (!running) return;

            let emptyIndices = options.map((v, i) => v === "" ? i : null).filter(v => v !== null);
            let chosenIndex;

            if (selectedDifficulty === "easy") {
                chosenIndex = emptyIndices[Math.floor(Math.random() * emptyIndices.length)];
            } 
            else if (selectedDifficulty === "medium") {
                if (Math.random() < 0.5) {
                    chosenIndex = emptyIndices[Math.floor(Math.random() * emptyIndices.length)];
                } else {
                    chosenIndex = getSmartMove();
                }
            } 
            else if (selectedDifficulty === "hard") {
                chosenIndex = getSmartMove();
            } 
            else if (selectedDifficulty === "impossible") {
                if (selectedGridSize === 3) {
                    let bestScore = -Infinity;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i] === "") {
                            options[i] = "O";
                            let score = minimax(options, 0, false, -Infinity, Infinity);
                            options[i] = "";
                            if (score > bestScore) {
                                bestScore = score;
                                chosenIndex = i;
                            }
                        }
                    }
                } else {
                    chosenIndex = getSmartMove();
                }
            }

            makeMove(chosenIndex, "O");
        }

        function minimax(board, depth, isMaximizing, alpha, beta) {
            if (checkBoardWin(board, "O")) return 10 - depth;
            if (checkBoardWin(board, "X")) return depth - 10;
            if (!board.includes("")) return 0;
            if (depth >= 6) return 0;

            if (isMaximizing) {
                let maxEval = -Infinity;
                for (let i = 0; i < board.length; i++) {
                    if (board[i] === "") {
                        board[i] = "O";
                        let evaluation = minimax(board, depth + 1, false, alpha, beta);
                        board[i] = "";
                        maxEval = Math.max(maxEval, evaluation);
                        alpha = Math.max(alpha, evaluation);
                        if (beta <= alpha) break;
                    }
                }
                return maxEval;
            } else {
                let minEval = Infinity;
                for (let i = 0; i < board.length; i++) {
                    if (board[i] === "") {
                        board[i] = "X";
                        let evaluation = minimax(board, depth + 1, true, alpha, beta);
                        board[i] = "";
                        minEval = Math.min(minEval, evaluation);
                        beta = Math.min(beta, evaluation);
                        if (beta <= alpha) break;
                    }
                }
                return minEval;
            }
        }

        function getSmartMove() {
            for (let i = 0; i < options.length; i++) {
                if (options[i] === "") {
                    options[i] = "O";
                    if (checkBoardWin(options, "O")) { options[i] = ""; return i; }
                    options[i] = "";
                }
            }
            for (let i = 0; i < options.length; i++) {
                if (options[i] === "") {
                    options[i] = "X";
                    if (checkBoardWin(options, "X")) { options[i] = ""; return i; }
                    options[i] = "";
                }
            }
            let center = Math.floor(options.length / 2);
            if (options[center] === "") return center;

            let emptyIndices = options.map((v, i) => v === "" ? i : null).filter(v => v !== null);
            return emptyIndices[Math.floor(Math.random() * emptyIndices.length)];
        }

        function checkBoardWin(boardState, player) {
            for (let i = 0; i < boardState.length; i++) {
                if (boardState[i] === player) {
                    const row = Math.floor(i / selectedGridSize);
                    const col = i % selectedGridSize;
                    const directions = [[0, 1], [1, 0], [1, 1], [1, -1]];

                    for (let [dr, dc] of directions) {
                        let count = 1;
                        for (let k = 1; k < selectedWinCondition; k++) {
                            let r = row + dr * k, c = col + dc * k;
                            if (r >= 0 && r < selectedGridSize && c >= 0 && c < selectedGridSize && boardState[r * selectedGridSize + c] === player) {
                                count++;
                            } else break;
                        }
                        if (count >= selectedWinCondition) return true;
                    }
                }
            }
            return false;
        }
    </script>
</body>
</html>
